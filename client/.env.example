# API Configuration
# 
# Development: Use localhost for local development
# Production: Replace with your actual production API URL
#
# Examples:
#   Development: VITE_API_URL=http://localhost:3001/api
#   Production:  VITE_API_URL=https://api.yourdomain.com/api
#   Staging:     VITE_API_URL=https://staging-api.yourdomain.com/api
#
VITE_API_URL=http://localhost:3001/api

# Demo mode: set to "true" to run without a backend (uses mock data).
# When true, the app shows a role selector and simulates all API responses.
# VITE_DEMO_MODE=true

# Optional: URL for "Maintenance History" link (client profile/rewards).
# Only used when VITE_DEMO_MODE is not set. Leave unset to hide the link.
# VITE_MAINTENANCE_HISTORY_URL=

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update VITE_API_URL with your actual API endpoint
# 3. For production, create .env.production with production URL
# 4. Never commit .env files to version control (they're in .gitignore)
#
# Environment-specific files:
#   - .env                 (loaded in all cases, usually for local development)
#   - .env.local           (loaded in all cases, ignored by git)
#   - .env.[mode]          (e.g., .env.production, .env.development)
#   - .env.[mode].local    (e.g., .env.production.local)
#
# Priority: .env.[mode].local > .env.local > .env.[mode] > .env
